{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web-apps",
      "destination": "/website-design",
      "permanent": true
    },
    {
      "source": "/founders",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/why",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/case-studies/xcraft-cloud",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/case-studies/walletwise",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "onyxx-tech.vercel.app"
        }
      ],
      "destination": "https://www.onyxxtechhub.com.my/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "onyxx-tech.vercel.app"
        }
      ],
      "destination": "https://www.onyxxtechhub.com.my/:path*",
      "permanent": true
    }
  ]
}
