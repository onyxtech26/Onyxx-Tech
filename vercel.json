{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "onyxx-tech.vercel.app" }],
      "destination": "https://www.onyxxtechhub.com.my/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "onyxx-tech.vercel.app" }],
      "destination": "https://www.onyxxtechhub.com.my/:path*",
      "permanent": true
    }
  ]
}
